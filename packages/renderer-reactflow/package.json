      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./prepare": {
      "types": "./src/prepare.ts",
      "import": "./src/prepare.ts",
      "default": "./src/prepare.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@icarus-graph-explorer/performance": "workspace:*",
    "@icarus-graph-explorer/view-projection": "workspace:*",
    "@xyflow/react": "12.11.5"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
