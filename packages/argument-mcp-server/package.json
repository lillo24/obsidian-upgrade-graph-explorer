{
  "name": "@icarus-graph-explorer/argument-mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --loader:.md=text --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run --root ../.. packages/argument-mcp-server/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@icarus-graph-explorer/argument-workspace": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "esbuild": "0.28.2"
  }
}
