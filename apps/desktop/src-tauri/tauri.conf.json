{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Icarus Graph Explorer",
  "version": "0.0.0",
  "identifier": "com.icarus.graph-explorer",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Icarus Graph Explorer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false
  }
}
