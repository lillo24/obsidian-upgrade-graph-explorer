{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Selected-vault reads, recursive watch acquisition, and private app-local identity state for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:read-dirs",
    "fs:read-files",
    "fs:read-meta",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "fs:create-app-specific-dirs",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    "fs:allow-applocaldata-meta-recursive"
  ]
}
